{
  "name": "cineflow-backend",
  "version": "1.0.0",
  "description": "Backend API for CineFlow movie streaming platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "typescript",
    "cineflow",
    "api"
