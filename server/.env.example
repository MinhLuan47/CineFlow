# Cấu hình Server (Server Configuration)
PORT=4000
NODE_ENV=development

# Cấu hình CORS và URL Client (CORS & Client URL)
CLIENT_URL=http://localhost:5173

# Cấu hình API TMDB (The Movie Database API)
# Truy cập https://www.themoviedb.org/ để lấy mã Access Token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Cấu hình Cache thời gian sống của dữ liệu (Cache TTL in seconds)
CACHE_TTL_SECONDS=21600
